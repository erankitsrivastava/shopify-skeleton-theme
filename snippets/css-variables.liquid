{% style %}
  {% # Loads all font variations with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  {% # Heading font variations %}
  {{ settings.type_heading_font | font_face: font_display: 'swap' }}
  {{ settings.type_heading_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}

  :root {
    /* Typography */
    --font-primary--family: {% if settings.type_primary_font.family %}{{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }}{% else %}Poppins, sans-serif{% endif %};
    --font-primary--style: {{ settings.type_primary_font.style | default: 'normal' }};
    --font-primary--weight: {{ settings.type_primary_font.weight | default: '400' }};
    --font-heading--family: {% if settings.type_heading_font.family %}{{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }}{% else %}Playfair Display, serif{% endif %};
    --font-heading--style: {{ settings.type_heading_font.style | default: 'normal' }};
    --font-heading--weight: {{ settings.type_heading_font.weight | default: '700' }};

    /* Layout */
    --page-width: {{ settings.max_page_width | default: '90rem' }};
    --page-margin: {{ settings.min_page_margin | default: 20 }}px;

    /* Primary Colors */
    --color-background: {{ settings.background_color | default: '#0f172a' }};
    --color-foreground: {{ settings.foreground_color | default: '#ffffff' }};
    --color-accent: {{ settings.accent_color | default: '#3b82f6' }};

    /* Secondary Colors */
    --color-secondary-bg: {{ settings.secondary_background | default: '#1e293b' }};
    --color-muted: {{ settings.muted_text_color | default: '#94a3b8' }};
    --color-border: {{ settings.border_color | default: '#334155' }};

    /* Button Colors */
    --color-button-primary-bg: {{ settings.button_primary_bg | default: '#3b82f6' }};
    --color-button-primary-text: {{ settings.button_primary_text | default: '#ffffff' }};
    --color-button-secondary-bg: {{ settings.button_secondary_bg | default: 'transparent' }};
    --color-button-secondary-text: {{ settings.button_secondary_text | default: '#ffffff' }};

    /* Border Radius */
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 8 }}px;
    --style-border-radius-buttons: {{ settings.button_corner_radius | default: 8 }}px;

    /* Shadows */
    --shadow-sm: 0 1px 2px 0 rgb(0 0 0 / 0.05);
    --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
    --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);

    /* Transitions */
    --transition-fast: 150ms ease;
    --transition-normal: 300ms ease;
    --transition-slow: 500ms ease;

    /* Spacing */
    --spacing-xs: 0.25rem;
    --spacing-sm: 0.5rem;
    --spacing-md: 1rem;
    --spacing-lg: 1.5rem;
    --spacing-xl: 2rem;
    --spacing-2xl: 3rem;
    --spacing-3xl: 4rem;

    /* Section Padding */
    --section-padding-y: 4rem;
    --section-padding-y-mobile: 2.5rem;
  }
{% endstyle %}
