{% comment %}
  Jewellery Hero Section
  Full-width hero with headline, subtext, CTAs and product image
{% endcomment %}

<section class="jewellery-hero section-padding" data-section-id="{{ section.id }}">
  <div class="hero-container">
    <div class="hero-content">
      {% if section.settings.subtitle != blank %}
        <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <h1 class="hero-title">
        {{ section.settings.title | default: "Where Heritage Meets Modern Luxury" }}
      </h1>

      {% if section.settings.description != blank %}
        <p class="hero-description">{{ section.settings.description }}</p>
      {% endif %}

      <div class="hero-buttons">
        {% if section.settings.button_1_text != blank %}
          <a href="{{ section.settings.button_1_link }}" class="btn btn-primary">
            {{ section.settings.button_1_text }}
            {% if section.settings.button_1_icon %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            {% endif %}
          </a>
        {% endif %}

        {% if section.settings.button_2_text != blank %}
          <a href="{{ section.settings.button_2_link }}" class="btn btn-secondary">
            {{ section.settings.button_2_text }}
            {% if section.settings.button_2_icon %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            {% endif %}
          </a>
        {% endif %}

        {% if section.settings.button_3_text != blank %}
          <a href="{{ section.settings.button_3_link }}" class="btn btn-outline">
            {{ section.settings.button_3_text }}
            {% if section.settings.button_3_icon %}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            {% endif %}
          </a>
        {% endif %}
      </div>
    </div>

    <div class="hero-image">
      {% if section.settings.image != blank %}
        <img
          src="{{ section.settings.image | image_url: width: 800 }}"
          srcset="{{ section.settings.image | image_url: width: 400 }} 400w,
                  {{ section.settings.image | image_url: width: 600 }} 600w,
                  {{ section.settings.image | image_url: width: 800 }} 800w"
          sizes="(max-width: 768px) 100vw, 50vw"
          alt="{{ section.settings.image_alt | default: section.settings.title }}"
          width="800"
          height="600"
          loading="eager"
          class="hero-img"
        >
      {% else %}
        <div class="hero-placeholder">
          <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
      {% endif %}

      {% if section.settings.show_badge %}
        <div class="hero-badge">
          <span class="badge-icon">{{ section.settings.badge_icon }}</span>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .jewellery-hero {
    background-color: var(--color-background);
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2xl);
    align-items: center;
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .hero-content {
    order: 2;
    text-align: center;
  }

  .hero-subtitle {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: var(--spacing-sm);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: var(--spacing-lg);
    color: var(--color-foreground);
  }

  .hero-description {
    font-size: 1rem;
    color: var(--color-muted);
    margin-bottom: var(--spacing-xl);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-md);
    justify-content: center;
  }

  .hero-image {
    order: 1;
    position: relative;
    display: flex;
    justify-content: center;
  }

  .hero-img {
    border-radius: 1rem;
    object-fit: cover;
    max-width: 100%;
    height: auto;
  }

  .hero-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-secondary-bg);
    border-radius: 1rem;
    width: 100%;
    aspect-ratio: 4/3;
    color: var(--color-muted);
  }

  .hero-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background-color: var(--color-accent);
    color: var(--color-foreground);
    padding: 0.5rem 1rem;
    border-radius: 2rem;
    font-size: 1.5rem;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  @media (min-width: 768px) {
    .hero-container {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-3xl);
    }

    .hero-content {
      order: 1;
      text-align: left;
    }

    .hero-image {
      order: 2;
    }

    .hero-buttons {
      justify-content: flex-start;
    }

    .hero-description {
      margin-left: 0;
      margin-right: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Jewellery Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Varun Jeweller's"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Where Heritage Meets Modern Luxury"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Timeless artistry, modern soul. Explore our designs"
    },
    {
      "type": "header",
      "content": "Primary Button"
    },
    {
      "type": "text",
      "id": "button_1_text",
      "label": "Button Text",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "button_1_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "button_1_icon",
      "label": "Show Arrow Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Secondary Button"
    },
    {
      "type": "text",
      "id": "button_2_text",
      "label": "Button Text",
      "default": "Shop Online"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "button_2_icon",
      "label": "Show Arrow Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Tertiary Button"
    },
    {
      "type": "text",
      "id": "button_3_text",
      "label": "Button Text",
      "default": "Visit Store"
    },
    {
      "type": "url",
      "id": "button_3_link",
      "label": "Button Link"
    },
    {
      "type": "checkbox",
      "id": "button_3_icon",
      "label": "Show Arrow Icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image Alt Text"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show Badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_icon",
      "label": "Badge Icon/Emoji",
      "default": "✨"
    }
  ],
  "presets": [
    {
      "name": "Jewellery Hero"
    }
  ]
}
{% endschema %}
