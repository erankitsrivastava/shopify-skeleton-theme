{% comment %}
  Trust Badges Section
  Display shipping, security, and return policy badges
{% endcomment %}

<section class="trust-badges section-padding" data-section-id="{{ section.id }}">
  <div class="badges-container">
    <div class="badges-grid">
      {% for block in section.blocks %}
        <div class="badge-item" {{ block.shopify_attributes }}>
          <div class="badge-icon">
            {% case block.settings.icon %}
              {% when 'shipping' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="1" y="3" width="15" height="13"></rect>
                  <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
                  <circle cx="5.5" cy="18.5" r="2.5"></circle>
                  <circle cx="18.5" cy="18.5" r="2.5"></circle>
                </svg>
              {% when 'security' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
              {% when 'returns' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="1 4 1 10 7 10"></polyline>
                  <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                </svg>
              {% when 'gift' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="20 12 20 22 4 22 4 12"></polyline>
                  <rect x="2" y="7" width="20" height="5"></rect>
                  <line x1="12" y1="22" x2="12" y2="7"></line>
                  <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"></path>
                  <path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"></path>
                </svg>
              {% when 'certified' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="8" r="7"></circle>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"></polyline>
                </svg>
              {% when 'support' %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
              {% else %}
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M9 12l2 2 4-4"></path>
                </svg>
            {% endcase %}
          </div>
          <div class="badge-content">
            <h3 class="badge-title">{{ block.settings.title }}</h3>
            {% if block.settings.description != blank %}
              <p class="badge-description">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .trust-badges {
    background-color: var(--color-background);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .badges-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .badges-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-xl);
  }

  .badge-item {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-md);
    text-align: left;
  }

  .badge-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    background-color: var(--color-accent);
    color: var(--color-foreground);
    border-radius: 50%;
  }

  .badge-content {
    flex: 1;
  }

  .badge-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0 0 var(--spacing-xs);
  }

  .badge-description {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .badges-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .badge-item {
      justify-content: center;
      text-align: center;
      flex-direction: column;
      align-items: center;
    }

    .badge-icon {
      margin-bottom: var(--spacing-sm);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Badges",
  "tag": "section",
  "class": "trust-section",
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping/Truck" },
            { "value": "security", "label": "Security/Shield" },
            { "value": "returns", "label": "Returns/Refresh" },
            { "value": "gift", "label": "Gift" },
            { "value": "certified", "label": "Certified/Medal" },
            { "value": "support", "label": "Support/Phone" },
            { "value": "check", "label": "Check/Default" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Trust Badge"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Description of this trust badge or feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "shipping",
            "title": "Pan India Shipping",
            "description": "Dispatch in 3 working days on all orders. Shipping anywhere in your location within 7-10 days. Extra care during transit."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "security",
            "title": "Secure Transactions",
            "description": "We use payment gateway BIS (Bureau) GST & DPDT (Direct Payment & Transfer) Credit Card & Debit Cards."
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "returns",
            "title": "Hassle-Free Returns",
            "description": "Change of heart? Get full value exchange within 7 days of the 7 days guaranteed delivery for all."
          }
        }
      ]
    }
  ]
}
{% endschema %}
