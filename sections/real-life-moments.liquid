{% comment %}
  Real-Life Moments Section
  Instagram-style gallery showing customer photos
{% endcomment %}

<section class="real-life-moments section-padding" data-section-id="{{ section.id }}">
  <div class="moments-container">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.title | default: "Real-Life Moments Of Elegance" }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="moments-wrapper">
      {% if section.settings.instagram_embed != blank %}
        <div class="instagram-embed">
          {{ section.settings.instagram_embed }}
        </div>
      {% else %}
        <div class="moments-grid">
          {% for block in section.blocks %}
            <div class="moment-item" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}
                <div class="moment-image-wrapper">
                  <img
                    src="{{ block.settings.image | image_url: width: 400 }}"
                    srcset="{{ block.settings.image | image_url: width: 300 }} 300w,
                            {{ block.settings.image | image_url: width: 400 }} 400w"
                    sizes="(max-width: 768px) 150px, 200px"
                    alt="{{ block.settings.alt_text | default: 'Customer moment' }}"
                    loading="lazy"
                    class="moment-image"
                  >
                  <div class="moment-overlay">
                    {% if block.settings.link != blank %}
                      <a href="{{ block.settings.link }}" target="_blank" rel="noopener" class="moment-link" aria-label="View on Instagram">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                          <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                          <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                        </svg>
                      </a>
                    {% endif %}
                    {% if block.settings.caption != blank %}
                      <p class="moment-caption">{{ block.settings.caption }}</p>
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <div class="moment-placeholder">
                  <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <circle cx="8.5" cy="8.5" r="1.5"></circle>
                    <polyline points="21 15 16 10 5 21"></polyline>
                  </svg>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <div class="moments-featured">
          {% if section.settings.featured_image != blank %}
            <div class="featured-image-wrapper">
              <img
                src="{{ section.settings.featured_image | image_url: width: 600 }}"
                alt="{{ section.settings.featured_alt | default: 'Featured moment' }}"
                loading="lazy"
                class="featured-image"
              >
              {% if section.settings.featured_caption != blank %}
                <div class="featured-caption">
                  <p>{{ section.settings.featured_caption }}</p>
                  {% if section.settings.featured_location != blank %}
                    <span class="featured-location">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                        <circle cx="12" cy="10" r="3"></circle>
                      </svg>
                      {{ section.settings.featured_location }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="moments-cta">
        <a href="{{ section.settings.button_link | default: settings.social_instagram }}" class="btn btn-primary" target="_blank" rel="noopener">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .real-life-moments {
    background-color: var(--color-background);
  }

  .moments-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .moments-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-lg);
  }

  .instagram-embed {
    max-width: 540px;
    margin: 0 auto;
    background-color: var(--color-secondary-bg);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
  }

  .instagram-embed iframe {
    width: 100%;
    border: none;
  }

  .moments-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--spacing-sm);
  }

  .moment-item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--style-border-radius-inputs);
  }

  .moment-image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .moment-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .moment-item:hover .moment-image {
    transform: scale(1.1);
  }

  .moment-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity var(--transition-normal);
    padding: var(--spacing-sm);
  }

  .moment-item:hover .moment-overlay {
    opacity: 1;
  }

  .moment-link {
    color: var(--color-foreground);
    margin-bottom: var(--spacing-sm);
  }

  .moment-caption {
    font-size: 0.75rem;
    color: var(--color-foreground);
    text-align: center;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .moment-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: var(--color-secondary-bg);
    color: var(--color-muted);
  }

  .moments-featured {
    margin-top: var(--spacing-lg);
  }

  .featured-image-wrapper {
    position: relative;
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    max-width: 500px;
    margin: 0 auto;
  }

  .featured-image {
    width: 100%;
    height: auto;
  }

  .featured-caption {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-md);
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.8));
    color: var(--color-foreground);
  }

  .featured-caption p {
    margin: 0 0 var(--spacing-xs);
    font-size: 0.875rem;
  }

  .featured-location {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .moments-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--spacing-2xl);
  }

  @media (min-width: 768px) {
    .moments-wrapper {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .moments-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .moments-featured {
      margin-top: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Real-Life Moments",
  "tag": "section",
  "class": "moments-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Real-Life Moments Of Elegance"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Instagram Embed"
    },
    {
      "type": "html",
      "id": "instagram_embed",
      "label": "Instagram Embed Code",
      "info": "Paste Instagram embed code here to display an Instagram post directly"
    },
    {
      "type": "header",
      "content": "Featured Image"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Image"
    },
    {
      "type": "text",
      "id": "featured_alt",
      "label": "Featured Image Alt Text"
    },
    {
      "type": "text",
      "id": "featured_caption",
      "label": "Featured Caption"
    },
    {
      "type": "text",
      "id": "featured_location",
      "label": "Location Tag"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "View on Instagram"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "blocks": [
    {
      "type": "moment",
      "name": "Moment Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Instagram Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Real-Life Moments",
      "blocks": [
        { "type": "moment" },
        { "type": "moment" },
        { "type": "moment" },
        { "type": "moment" },
        { "type": "moment" },
        { "type": "moment" }
      ]
    }
  ]
}
{% endschema %}
