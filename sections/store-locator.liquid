{% comment %}
  Store Locator Section
  Display store location with map and contact information
{% endcomment %}

<section class="store-locator section-padding" data-section-id="{{ section.id }}">
  <div class="locator-container">
    <div class="locator-grid">
      <!-- Map Section -->
      <div class="locator-map">
        {% if section.settings.map_embed != blank %}
          <div class="map-embed">
            {{ section.settings.map_embed }}
          </div>
        {% elsif section.settings.map_image != blank %}
          <img
            src="{{ section.settings.map_image | image_url: width: 800 }}"
            alt="Store location map"
            class="map-image"
            loading="lazy"
          >
        {% else %}
          <div class="map-placeholder">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            <p>Map location</p>
          </div>
        {% endif %}

        <!-- Map Markers -->
        {% if section.settings.show_marker %}
          <div class="map-marker">
            <div class="marker-pin">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3" fill="white"></circle>
              </svg>
            </div>
          </div>
        {% endif %}
      </div>

      <!-- Store Info Section -->
      <div class="locator-info">
        <div class="info-header">
          {% if section.settings.store_logo != blank %}
            <img
              src="{{ section.settings.store_logo | image_url: width: 200 }}"
              alt="{{ section.settings.store_name }}"
              class="store-logo"
              loading="lazy"
            >
          {% endif %}
          <h2 class="info-title">{{ section.settings.title | default: "Visit Our Offline Store In Gomti Nagar Today" }}</h2>
        </div>

        <div class="info-content">
          <!-- Getting Here -->
          <div class="info-block">
            <h3 class="block-title">Getting Here</h3>
            {% if section.settings.address != blank %}
              <p class="info-text">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                {{ section.settings.address }}
              </p>
            {% endif %}
            {% if section.settings.directions_link != blank %}
              <a href="{{ section.settings.directions_link }}" class="directions-link" target="_blank" rel="noopener">
                Get Directions
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            {% endif %}
          </div>

          <!-- Connect With Us -->
          <div class="info-block">
            <h3 class="block-title">Connect With Us</h3>
            {% if settings.store_phone != blank %}
              <p class="info-text">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                <a href="tel:{{ settings.store_phone | remove: ' ' }}">{{ settings.store_phone }}</a>
              </p>
            {% endif %}
            {% if settings.store_email != blank %}
              <p class="info-text">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <a href="mailto:{{ settings.store_email }}">{{ settings.store_email }}</a>
              </p>
            {% endif %}

            <!-- Social Links -->
            <div class="social-links">
              {% if settings.social_instagram != blank %}
                <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram" class="social-link instagram">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                </a>
              {% endif %}
              {% if settings.social_facebook != blank %}
                <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook" class="social-link facebook">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                </a>
              {% endif %}
              {% if settings.social_youtube != blank %}
                <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube" class="social-link youtube">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                  </svg>
                </a>
              {% endif %}
              {% if settings.social_whatsapp != blank %}
                <a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp" class="social-link whatsapp">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                </a>
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .store-locator {
    background-color: var(--color-background);
  }

  .locator-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .locator-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2xl);
    align-items: start;
  }

  .locator-map {
    position: relative;
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    background-color: var(--color-secondary-bg);
  }

  .map-embed {
    position: relative;
    padding-bottom: 75%;
    height: 0;
  }

  .map-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .map-image {
    width: 100%;
    height: auto;
    display: block;
  }

  .map-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    color: var(--color-muted);
  }

  .map-placeholder p {
    margin-top: var(--spacing-md);
    font-size: 0.875rem;
  }

  .map-marker {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -100%);
  }

  .marker-pin {
    color: var(--color-accent);
    animation: bounce 2s infinite;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .locator-info {
    background-color: var(--color-secondary-bg);
    border-radius: var(--style-border-radius-inputs);
    padding: var(--spacing-xl);
  }

  .info-header {
    margin-bottom: var(--spacing-xl);
  }

  .store-logo {
    max-width: 150px;
    height: auto;
    margin-bottom: var(--spacing-md);
  }

  .info-title {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    color: var(--color-foreground);
    margin: 0;
  }

  .info-content {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-xl);
  }

  .info-block {
    padding-bottom: var(--spacing-lg);
    border-bottom: 1px solid var(--color-border);
  }

  .info-block:last-child {
    padding-bottom: 0;
    border-bottom: none;
  }

  .block-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0 0 var(--spacing-md);
  }

  .info-text {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-sm);
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0 0 var(--spacing-sm);
  }

  .info-text svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .info-text a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .info-text a:hover {
    color: var(--color-accent);
  }

  .directions-link {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.875rem;
    color: var(--color-accent);
    text-decoration: none;
    margin-top: var(--spacing-sm);
    transition: opacity var(--transition-fast);
  }

  .directions-link:hover {
    opacity: 0.8;
  }

  .social-links {
    display: flex;
    gap: var(--spacing-md);
    margin-top: var(--spacing-md);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 8px;
    color: var(--color-foreground);
    transition: all var(--transition-fast);
  }

  .social-link.instagram {
    background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
  }

  .social-link.facebook {
    background-color: #1877f2;
  }

  .social-link.youtube {
    background-color: #ff0000;
  }

  .social-link.whatsapp {
    background-color: #25d366;
  }

  .social-link:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 768px) {
    .locator-grid {
      grid-template-columns: 1fr 1fr;
    }

    .locator-map {
      min-height: 400px;
    }

    .map-embed {
      padding-bottom: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Store Locator",
  "tag": "section",
  "class": "locator-section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Visit Our Offline Store In Gomti Nagar Today"
    },
    {
      "type": "header",
      "content": "Map"
    },
    {
      "type": "html",
      "id": "map_embed",
      "label": "Google Maps Embed Code",
      "info": "Paste the iframe embed code from Google Maps"
    },
    {
      "type": "image_picker",
      "id": "map_image",
      "label": "Map Image (if no embed)"
    },
    {
      "type": "checkbox",
      "id": "show_marker",
      "label": "Show Animated Marker",
      "default": true
    },
    {
      "type": "header",
      "content": "Store Information"
    },
    {
      "type": "image_picker",
      "id": "store_logo",
      "label": "Store Logo"
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "Varun Jewellers"
    },
    {
      "type": "textarea",
      "id": "address",
      "label": "Store Address",
      "default": "Office Jewellers Office, Shop no. 7, Purana Road, Gomti Nagar, Lucknow-226010, INDIA"
    },
    {
      "type": "url",
      "id": "directions_link",
      "label": "Directions Link (Google Maps)"
    }
  ],
  "presets": [
    {
      "name": "Store Locator"
    }
  ]
}
{% endschema %}
