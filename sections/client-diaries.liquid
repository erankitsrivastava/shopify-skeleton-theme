{% comment %}
  Client Diaries Section
  Social media style posts with customer content and stats
{% endcomment %}

<section class="client-diaries section-padding" data-section-id="{{ section.id }}">
  <div class="client-diaries-container">
    <div class="section-header">
      <h2 class="section-title">{{ section.settings.title | default: "Client Diaries" }}</h2>
      {% if section.settings.subtitle != blank %}
        <p class="section-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="diaries-grid">
      {% for block in section.blocks %}
        {% if block.type == 'post' %}
          <div class="diary-card" {{ block.shopify_attributes }}>
            <div class="diary-header">
              {% if block.settings.avatar != blank %}
                <img
                  src="{{ block.settings.avatar | image_url: width: 80 }}"
                  alt="{{ block.settings.username }}"
                  class="diary-avatar"
                  loading="lazy"
                >
              {% else %}
                <div class="diary-avatar-placeholder">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                    <circle cx="12" cy="7" r="4"></circle>
                  </svg>
                </div>
              {% endif %}
              <div class="diary-user-info">
                <span class="diary-username">{{ block.settings.username | default: "@customer" }}</span>
                <span class="diary-handle">{{ block.settings.handle }}</span>
              </div>
              <div class="diary-platform">
                {% if block.settings.platform == 'instagram' %}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                  </svg>
                {% elsif block.settings.platform == 'facebook' %}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                  </svg>
                {% else %}
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
                    <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
                  </svg>
                {% endif %}
              </div>
            </div>

            {% if block.settings.image != blank %}
              <div class="diary-image-wrapper">
                <img
                  src="{{ block.settings.image | image_url: width: 400 }}"
                  alt="{{ block.settings.caption | strip_html | truncate: 50 }}"
                  class="diary-image"
                  loading="lazy"
                >
              </div>
            {% endif %}

            {% if block.settings.caption != blank %}
              <div class="diary-caption">
                <p>{{ block.settings.caption }}</p>
              </div>
            {% endif %}

            <div class="diary-engagement">
              <span class="engagement-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
                {{ block.settings.likes | default: '0' }}
              </span>
              <span class="engagement-item">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
                </svg>
                {{ block.settings.comments | default: '0' }}
              </span>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Stats Section -->
    <div class="diaries-stats">
      {% for block in section.blocks %}
        {% if block.type == 'stat' %}
          <div class="stat-item" {{ block.shopify_attributes }}>
            <span class="stat-value">{{ block.settings.value }}</span>
            <span class="stat-label">{{ block.settings.label }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .client-diaries {
    background-color: var(--color-background);
  }

  .client-diaries-container {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 var(--page-margin);
  }

  .diaries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--spacing-lg);
    margin-bottom: var(--spacing-3xl);
  }

  .diary-card {
    background-color: var(--color-secondary-bg);
    border-radius: var(--style-border-radius-inputs);
    overflow: hidden;
    transition: transform var(--transition-normal);
  }

  .diary-card:hover {
    transform: translateY(-4px);
  }

  .diary-header {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    padding: var(--spacing-md);
  }

  .diary-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .diary-avatar-placeholder {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted);
  }

  .diary-user-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .diary-username {
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--color-foreground);
  }

  .diary-handle {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .diary-platform {
    color: var(--color-muted);
  }

  .diary-image-wrapper {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .diary-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .diary-card:hover .diary-image {
    transform: scale(1.05);
  }

  .diary-caption {
    padding: var(--spacing-md);
  }

  .diary-caption p {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .diary-engagement {
    display: flex;
    gap: var(--spacing-lg);
    padding: var(--spacing-md);
    border-top: 1px solid var(--color-border);
  }

  .engagement-item {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .engagement-item svg {
    color: var(--color-accent);
  }

  /* Stats Section */
  .diaries-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-lg);
    padding: var(--spacing-2xl);
    background-color: var(--color-secondary-bg);
    border-radius: var(--style-border-radius-inputs);
  }

  .stat-item {
    text-align: center;
  }

  .stat-value {
    display: block;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    color: var(--color-foreground);
    font-family: var(--font-heading--family);
  }

  .stat-label {
    display: block;
    font-size: 0.75rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: var(--spacing-xs);
  }

  @media (min-width: 768px) {
    .diaries-stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .diaries-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
