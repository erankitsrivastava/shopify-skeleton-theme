{% comment %}
  Jewellery Footer Section
  Footer with copyright and social links
{% endcomment %}

<footer class="jewellery-footer" data-section-id="{{ section.id }}">
  <div class="footer-container">
    {% if section.settings.show_top_section %}
      <div class="footer-top">
        <div class="footer-grid">
          <!-- Logo and About -->
          <div class="footer-column footer-about">
            {% if section.settings.logo != blank %}
              <a href="{{ routes.root_url }}" class="footer-logo">
                <img
                  src="{{ section.settings.logo | image_url: width: 200 }}"
                  alt="{{ shop.name }}"
                  width="{{ section.settings.logo_width }}"
                  height="auto"
                  loading="lazy"
                >
              </a>
            {% else %}
              <a href="{{ routes.root_url }}" class="footer-logo-text">
                {{ section.settings.logo_text | default: shop.name }}
              </a>
            {% endif %}
            {% if section.settings.about_text != blank %}
              <p class="footer-about-text">{{ section.settings.about_text }}</p>
            {% endif %}
          </div>

          <!-- Menu Columns -->
          {% for block in section.blocks %}
            {% if block.type == 'menu_column' %}
              <div class="footer-column" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <h4 class="footer-column-title">{{ block.settings.title }}</h4>
                {% endif %}
                {% if block.settings.menu != blank %}
                  <ul class="footer-menu">
                    {% for link in block.settings.menu.links %}
                      <li>
                        <a href="{{ link.url }}">{{ link.title }}</a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}

          <!-- Newsletter -->
          {% if section.settings.show_newsletter %}
            <div class="footer-column footer-newsletter">
              <h4 class="footer-column-title">{{ section.settings.newsletter_title | default: 'Stay Updated' }}</h4>
              {% if section.settings.newsletter_text != blank %}
                <p class="newsletter-text">{{ section.settings.newsletter_text }}</p>
              {% endif %}
              {% form 'customer', class: 'newsletter-form' %}
                <div class="form-group">
                  <input
                    type="email"
                    name="contact[email]"
                    placeholder="{{ section.settings.newsletter_placeholder | default: 'Enter your email' }}"
                    required
                    class="newsletter-input"
                  >
                  <button type="submit" class="newsletter-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <line x1="22" y1="2" x2="11" y2="13"></line>
                      <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                    </svg>
                  </button>
                </div>
                <input type="hidden" name="contact[tags]" value="newsletter">
              {% endform %}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="footer-bottom">
      <div class="footer-bottom-content">
        <p class="copyright">
          {{ section.settings.copyright_text | default: 'Copyright' }} &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.rights_text | default: 'All rights reserved.' }}
        </p>

        <div class="footer-social">
          {% if settings.social_instagram != blank %}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
              </svg>
            </a>
          {% endif %}
          {% if settings.social_facebook != blank %}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
              </svg>
            </a>
          {% endif %}
          {% if settings.social_youtube != blank %}
            <a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {% endif %}
          {% if settings.social_whatsapp != blank %}
            <a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>
          {% endif %}
          {% if settings.social_twitter != blank %}
            <a href="{{ settings.social_twitter }}" target="_blank" rel="noopener" aria-label="Twitter">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
  .jewellery-footer {
    background-color: var(--color-secondary-bg);
    color: var(--color-foreground);
  }

  .footer-container {
    max-width: var(--page-width);
    margin: 0 auto;
  }

  .footer-top {
    padding: var(--spacing-3xl) var(--page-margin);
    border-bottom: 1px solid var(--color-border);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--spacing-2xl);
  }

  .footer-column {
    min-width: 0;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: var(--spacing-md);
  }

  .footer-logo img {
    max-width: 150px;
    height: auto;
  }

  .footer-logo-text {
    display: inline-block;
    font-family: var(--font-heading--family);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    text-decoration: none;
    margin-bottom: var(--spacing-md);
  }

  .footer-about-text {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
  }

  .footer-column-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-foreground);
    margin: 0 0 var(--spacing-md);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-menu {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .footer-menu li {
    margin-bottom: var(--spacing-sm);
  }

  .footer-menu a {
    font-size: 0.875rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-menu a:hover {
    color: var(--color-accent);
  }

  .newsletter-text {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin: 0 0 var(--spacing-md);
  }

  .newsletter-form .form-group {
    display: flex;
    gap: var(--spacing-sm);
  }

  .newsletter-input {
    flex: 1;
    padding: 0.75rem 1rem;
    background-color: var(--color-background);
    border: 1px solid var(--color-border);
    color: var(--color-foreground);
    font-size: 0.875rem;
  }

  .newsletter-input::placeholder {
    color: var(--color-muted);
  }

  .newsletter-btn {
    padding: 0.75rem;
    background-color: var(--color-accent);
    border: none;
    color: var(--color-foreground);
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
    transition: opacity var(--transition-fast);
  }

  .newsletter-btn:hover {
    opacity: 0.9;
  }

  .footer-bottom {
    padding: var(--spacing-lg) var(--page-margin);
  }

  .footer-bottom-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-md);
    text-align: center;
  }

  .copyright {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin: 0;
  }

  .footer-social {
    display: flex;
    gap: var(--spacing-md);
  }

  .footer-social a {
    color: var(--color-muted);
    transition: color var(--transition-fast);
  }

  .footer-social a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .footer-about {
      grid-column: span 2;
    }
  }

  @media (min-width: 768px) {
    .footer-bottom-content {
      flex-direction: row;
      justify-content: space-between;
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: 2fr repeat(3, 1fr);
    }

    .footer-about {
      grid-column: span 1;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Jewellery Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_top_section",
      "label": "Show Top Section",
      "default": true
    },
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text (if no image)",
      "default": "Varun Jewellers"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Logo Width",
      "default": 120
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Text",
      "default": "Where heritage meets modern luxury. Crafting timeless jewellery pieces since 1980."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "Stay Updated"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter Text",
      "default": "Subscribe for exclusive offers and new arrivals."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "header",
      "content": "Copyright"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Copyright"
    },
    {
      "type": "text",
      "id": "rights_text",
      "label": "Rights Text",
      "default": "All rights reserved."
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu Column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Title",
          "default": "Quick Links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Jewellery Footer",
      "blocks": [
        {
          "type": "menu_column",
          "settings": {
            "title": "Quick Links"
          }
        },
        {
          "type": "menu_column",
          "settings": {
            "title": "Customer Service"
          }
        }
      ]
    }
  ]
}
{% endschema %}
