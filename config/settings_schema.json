[
  {
    "name": "theme_info",
    "theme_name": "Varun Jewellers",
    "theme_version": "1.0.0",
    "theme_author": "Varun Jewellers",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "poppins_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n4",
        "label": "Heading Font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          },
          {
            "value": "120rem",
            "label": "Extra Wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "header",
        "content": "Primary Colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "default": "#0f172a",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#ffffff",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "accent_color",
        "default": "#3b82f6",
        "label": "Accent Color"
      },
      {
        "type": "header",
        "content": "Secondary Colors"
      },
      {
        "type": "color",
        "id": "secondary_background",
        "default": "#1e293b",
        "label": "Secondary Background"
      },
      {
        "type": "color",
        "id": "muted_text_color",
        "default": "#94a3b8",
        "label": "Muted Text Color"
      },
      {
        "type": "color",
        "id": "border_color",
        "default": "#334155",
        "label": "Border Color"
      },
      {
        "type": "header",
        "content": "Button Colors"
      },
      {
        "type": "color",
        "id": "button_primary_bg",
        "default": "#3b82f6",
        "label": "Primary Button Background"
      },
      {
        "type": "color",
        "id": "button_primary_text",
        "default": "#ffffff",
        "label": "Primary Button Text"
      },
      {
        "type": "color",
        "id": "button_secondary_bg",
        "default": "transparent",
        "label": "Secondary Button Background"
      },
      {
        "type": "color",
        "id": "button_secondary_text",
        "default": "#ffffff",
        "label": "Secondary Button Text"
      },
      {
        "type": "header",
        "content": "Other Settings"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 8
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 30,
        "step": 1,
        "unit": "px",
        "label": "Button Corner Radius",
        "default": 8
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "header",
        "content": "Social Media Links"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_whatsapp",
        "label": "WhatsApp"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_twitter",
        "label": "Twitter/X"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "Pinterest"
      }
    ]
  },
  {
    "name": "Store Information",
    "settings": [
      {
        "type": "header",
        "content": "Contact Information"
      },
      {
        "type": "text",
        "id": "store_phone",
        "label": "Phone Number",
        "default": "+91 9876543210"
      },
      {
        "type": "text",
        "id": "store_email",
        "label": "Email Address",
        "default": "info@varunjewellers.com"
      },
      {
        "type": "textarea",
        "id": "store_address",
        "label": "Store Address",
        "default": "Gomti Nagar, Lucknow, India"
      },
      {
        "type": "text",
        "id": "store_hours",
        "label": "Store Hours",
        "default": "Mon-Sat: 10AM - 8PM"
      }
    ]
  }
]
